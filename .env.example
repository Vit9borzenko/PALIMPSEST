# PostgreSQL
POSTGRES_USER=tg_user
POSTGRES_PASSWORD=tg_password
POSTGRES_DB=tg_analytics
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://tg_user:tg_password@postgres:5432/tg_analytics
DATABASE_URL_SYNC=postgresql://tg_user:tg_password@postgres:5432/tg_analytics

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# App
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256
API_KEY_INTERNAL=internal-api-key-change-me

# Telegram (опционально для реального парсинга)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=

# OpenAI (опционально)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Whisper (если хочешь локальную транскрибацию)
WHISPER_MODEL=base

# Celery
CELERY_CONCURRENCY=2

# Ports для docker-compose
NGINX_PORT=80
